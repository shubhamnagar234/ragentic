# ==============================================================================
# Ragentic Monorepo Environment Configuration Reference
# See backend/.env.example and frontend/.env.example for localized configurations
# ==============================================================================

# Core Services
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5433/ragentic
QDRANT_URL=http://localhost:6333
REDIS_URL=redis://localhost:6379/0

# API Keys
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Next.js Public
NEXT_PUBLIC_API_URL=http://localhost:8000
