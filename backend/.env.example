# ==============================================================================
# Ragentic Backend Environment Configuration
# Copy this file to backend/.env and replace placeholders with your credentials
# ==============================================================================

# Database Configuration (PostgreSQL 16+ with asyncpg)
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5433/ragentic

# Vector Store (Qdrant)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=your_qdrant_api_key_optional_for_local
QDRANT_COLLECTION=ragentic-minilm
QDRANT_VECTOR_DIM=384

# Message Broker & Cache (Redis)
REDIS_URL=redis://localhost:6379/0

# LLM Providers (LiteLLM Gateway)
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Security & Session Authentication
SECRET_KEY=generate_a_random_32_byte_hex_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
ENVIRONMENT=development
ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","https://ragentic.vercel.app"]

# Model Routing & Embeddings
LLM_PRIMARY_MODEL=gemini/gemini-2.5-flash
LLM_LITE_MODEL=gemini/gemini-2.5-flash
LLM_FALLBACK_MODEL=gemini/gemini-2.5-flash
LLM_VISION_MODEL=gemini-2.5-flash
EMBEDDING_MODEL_TEXT=all-MiniLM-L6-v2
EMBEDDING_MODEL_CODE=all-MiniLM-L6-v2
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Observability & Tracing (Optional)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_PROJECT=ragentic

# Object Storage (Cloudflare R2 / AWS S3 - Optional for raw file artifacts)
R2_BUCKET_NAME=ragentic-files
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key
R2_SECRET_ACCESS_KEY=your_r2_secret_key
